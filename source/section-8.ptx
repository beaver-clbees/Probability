    <task workspace="1in">
        <statement>
            <p>
                In a carton of <m>12</m> eggs, <m>5</m> are cracked. <m>4</m>
                  eggs are selected at random. Let <m>X</m> be the number
                  cracked.
            </p>
        </statement>
    </task>
     <task workspace="1in">
        <statement>
            <p>
                Each question on a multiple choice test has 4 possible
                  answers. Your randomly guess the answer to each question.
                  There are 5 such questions on the test. Let <m>X</m> be the
                  number of questions you get correct.
            </p>
        </statement>
    </task> 
    <task workspace="1in">
        <statement>
                <p>
                  A person is chosen at random among all people who own one cell
                  phone. Let <m>X</m> be the last digit of their cell phone
                  number.
                </p>
        </statement>
    </task>
    </exercise>
    </page>
    <page>
    <exercise>
        <introduction>
            <p>
                 In a carton of <m>12</m> eggs, <m>5</m> are cracked. <m>4</m> eggs
            are selected at random. Let <m>X</m> be the number cracked. For each
            part, first write the question as <m>f(k), F(k), </m> or <m>1-F(k)</m> for the correct value of <m>k</m>, then solve. Recall
             that <m> f(k) = P(X=k), F(k) = P(X\le k)</m> and <m>1-F(k) = P(X>k)</m>.
            </p>
        </introduction>
  
         <task workspace="1.5in">
          <statement>
            <p>
                Find the probability that 3 eggs are cracked.
            </p>
          </statement>
        </task>
        <task workspace="1.5in">
          <statement>
            <p>
               Find the probability that no more than <m>1</m> is cracked.
            </p>
          </statement>
        </task>
         <task workspace="1.5in">
          <statement>
            <p>
               Find the probability that at least one is cracked.
            </p>
          </statement>
        </task>      
     
      </exercise>
      </page>
