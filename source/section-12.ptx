  <exercise workspace = "2in">
  <statement>
    <p>
      Suppose each lottery ticket in OR has a <m>0.1</m> probability of being a
      winner. I have a stack of <m>3</m> lottery tickets. Let <m>X</m> be the
      number of winning tickets. How is <m>X</m> distributed? Find the expected number of winners.    
    </p>
  </statement>
    </exercise>
    
      <exercise workspace="1in">
        <statement>
            <p>
                Suppose in my stack of <m>20</m> lottery tickets, 6 are winners. I draw
      <m>5</m> tickets at random and let <m>X</m> be the number of winning
      tickets. How is <m>X</m> distributed? Find the expected number of winners.  
            </p>
        </statement>
        </exercise>
