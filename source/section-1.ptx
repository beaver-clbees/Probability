<exercise>
<statement>
  <p> A' is the complement of A (all elements in S that are NOT in A). Shade A'.
  </p>
    <image width="40%">
  <latex-image>\begin{tikzpicture}[fill=gray, scale = 0.5]
\draw (0,0) circle (1.5) (-.5,1.25)  node [font=\tiny,text=black,above] {$A$}
