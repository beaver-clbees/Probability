<theorem xml:id="independent-events-theorem">
    <title>Independent Events Theorem (B:1.4-1)</title> 
    <statement>
      <p>
        If <m>A</m> and <m>B</m> are independent events, then the following
        pairs of events are also independent:
      </p>
      <ol>
