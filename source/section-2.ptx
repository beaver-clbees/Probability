    </image>
 </exercise>
 <theorem xml:id="thm-less-than-one">
    <title>Probability of an Event is less than 1</title>
      
    <statement>
        <p>
        If      <m>A\subseteq S</m>, then <m>P(A) \leq 1</m>.
        </p>
    </statement>
 </theorem>
 <exercise workspace="1in">
    <alert>Proof:</alert>
 </exercise>
<theorem>
    <title>Inclusion-Exclusion Probability (Union)</title>
    <statement>
        <p>
            For any two events A and B, <m>P(A \cup B) = P(A) + P(B) - P(A \cap B)</m>.
        </p>
    </statement>
</theorem>
 <exercise workspace="3in">
    <alert>Proof:</alert>
    <image width="40%">
        <latex-image>
        \begin{tikzpicture}[fill=gray, scale = 0.5]
