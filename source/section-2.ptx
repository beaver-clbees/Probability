\draw (-2,-2) rectangle (4,2) node [font=\tiny,text=black,above] {$S$};
\end{tikzpicture}
    </latex-image>
    </image>
<ul>
<li>
    <p>
        <m>(A \cap B)' = A' \cup B'</m>
    </p>
    </li>
</ul>
    <image width="40%">
        <latex-image>
              \begin{tikzpicture}[fill=gray, scale = 0.5]
