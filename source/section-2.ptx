 <theorem xml:id="thm-complement">
    <title>Complementary Probability</title>
    
    
    <statement>
        <p>
           For each event A, <m>P(A)=1-P(A').</m> 
        </p>
    </statement>
 </theorem>
 <exercise workspace="1in">
 <statement>
    <p>
         <alert>Proof:</alert>
    </p>
 </statement>
 </exercise>
 </page>
 <page>
<theorem xml:id="thm-emptyset">
    <title>Probability of Empty Set</title>
    <statement>
        <p>
            <m>P(\emptyset) = 0</m>.
        </p>
    </statement>
</theorem>
 <exercise workspace="1in">
 <statement>
    <p>
    <alert>Proof:</alert>    
    </p>
 </statement>
 </exercise>
<theorem xml:id="thm-subset">
    <title>Probability of Subset</title>
    <statement>
        <p>
            If <m>A\subseteq B</m>, then <m>P(A) \leq P(B)</m>.
        </p>
    </statement>
</theorem>
 <exercise workspace="1in">
 <statement>
    <p>
    <alert>Proof:</alert>    
    </p>
 </statement>
    
    <sidebyside margins="30%">
    <image>
        <latex-image xml:id="venn-subset-1">
\begin{tikzpicture}[fill=gray]
\scope
\clip (0,0) circle (1.5);
\fill (0,0) circle (0.75); % fills everything that in this circle that is also inside the circle centered at (1,0)
\endscope
% outline
\draw (0,0) circle (1.5) (-.5,1)  node [font=\tiny,text=black] {$B$}
      (0,0) circle (0.75) ((0,0)  node [font=\tiny,text=white] {$A$}
      (-2,-2) rectangle (2,2) node [text=black,above] {$S$};
\end{tikzpicture}
</latex-image>
</image>
