<worksheet>
<title>Properties of Sets</title>
<p> Commutative laws 
<ul>
<li> <p><m>A \cup B = B \cup A</m></p></li>
<li> <p><m>A \cap B = B \cap A</m></p></li>
</ul>
</p>
<p>Associative Laws
<ul>
<li>
    <p>
        <m>(A \cup B) \cup C = A \cup (B \cup C)</m>
    </p>
</li>
    <li>
        <p>
            <m>(A \cap B) \cap C = A \cap (B \cap C)</m>
        </p>
    </li>
</ul>
</p>
<image width="40%">
<latex-image>
    \begin{tikzpicture}
        \draw (-1.5,-2.5) rectangle (2.5,1.5)
    (0,0) circle (1) (-.25,0) node [text=black,above] {$A$}
    (1,0) circle (1) (1.25,0) node [text=black,above] {$B$}
    (0.5,-1) circle (1) node [text=black,below] {$C$};
\end{tikzpicture}
\begin{tikzpicture}
    \draw (-1.5,-2.5) rectangle (2.5,1.5)
    (0,0) circle (1) (-.25,0) node [text=black,above] {$A$}
    (1,0) circle (1) (1.25,0) node [text=black,above] {$B$}
    (0.5,-1) circle (1) node [text=black,below] {$C$};
\end{tikzpicture}
    \begin{tikzpicture}
    \draw (-1.5,-2.5) rectangle (2.5,1.5)
    (0,0) circle (1) (-.25,0) node [text=black,above] {$A$}
    (1,0) circle (1) (1.25,0) node [text=black,above] {$B$}
    (0.5,-1) circle (1) node [text=black,below] {$C$};
    \end{tikzpicture}
</latex-image>
</image>
<p> Distributive Laws
<ul>
<li>
    <p>
        <m>A \cap (B \cup C) = (A \cap B) \cup (A \cap C)</m>
    </p>
</li>
</ul>
</p>
<image width="40%">
<latex-image>
    \begin{tikzpicture}
     \draw (-1.5,-2.5) rectangle (2.5,1.5)
    (0,0) circle (1) (-.25,0) node [text=black,above] {$A$}
    (1,0) circle (1) (1.25,0) node [text=black,above] {$B$}
    (0.5,-1) circle (1) node [text=black,below] {$C$};
\end{tikzpicture}
  \begin{tikzpicture}
    \draw (-1.5,-2.5) rectangle (2.5,1.5)
    (0,0) circle (1) (-.25,0) node [text=black,above] {$A$}
    (1,0) circle (1) (1.25,0) node [text=black,above] {$B$}
    (0.5,-1) circle (1) node [text=black,below] {$C$};
\end{tikzpicture}
</latex-image>
</image>
<ul>
<li>
    <p>
        <m>A \cup (B \cap C) = (A \cup B) \cap (A \cup C)</m>
    </p>
</li>
</ul>
<image width="40%">
<latex-image>
    \begin{tikzpicture}
     \draw (-1.5,-2.5) rectangle (2.5,1.5)
    (0,0) circle (1) (-.25,0) node [text=black,above] {$A$}
    (1,0) circle (1) (1.25,0) node [text=black,above] {$B$}
    (0.5,-1) circle (1) node [text=black,below] {$C$};
\end{tikzpicture}
  \begin{tikzpicture}
    \draw (-1.5,-2.5) rectangle (2.5,1.5)
    (0,0) circle (1) (-.25,0) node [text=black,above] {$A$}
    (1,0) circle (1) (1.25,0) node [text=black,above] {$B$}
    (0.5,-1) circle (1) node [text=black,below] {$C$};
\end{tikzpicture}
</latex-image>
</image>

<p>De Morgan's Laws </p>

<ul>
  <li>
    <p>
        <m>(A \cup B)' = A' \cap B'</m>
    </p>
    </li>
</ul>
<image width="40%">
    <latex-image>
       \begin{tikzpicture}[fill=gray, scale = 0.5]
\draw[black] (0,0) circle (1.5) (-1,1.25)  node [font=\tiny,text=black,above] {$A$}
