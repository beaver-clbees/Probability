    <exercise workspace="1in">
        <statement>
            <p>
                 Suppose A and B are subsets of the sample space S. If <m>P(A \cup B)=0.90</m>, <m>P(A' \cup B) = 0.40</m>, then find <m>P(B)</m>
            </p>
        </statement>
        <image width="40%">
